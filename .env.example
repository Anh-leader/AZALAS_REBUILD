R2_BUCKET=
R2_ENDPOINT_URL=
R2_PUBLIC_BASE_URL=
R2_SIGNED_URL_EXPIRE_SECONDS=300
MAX_UPLOAD_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
