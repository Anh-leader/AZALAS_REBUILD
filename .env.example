# Giá trị DEMO cho môi trường local. Không dùng cho production.
DATABASE_URL=postgresql+psycopg://azalas:azalas_dev@localhost:5433/azalas
TEST_DATABASE_URL=postgresql+psycopg://azalas:azalas_dev@localhost:5433/azalas_test
JWT_SECRET=dev-only-change-me-use-a-32-byte-minimum-key
